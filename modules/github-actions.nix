# Exposes `githubActions`: the CI matrix for .github/workflows/build.yml, one
# job per check. check-flake-file is left out because flake.nix is maintained
# by hand rather than generated by flake-file.
{ inputs, lib, self, ... }:
{
  flake-file.inputs.nix-github-actions = {
    url = "github:nix-community/nix-github-actions";
    inputs.nixpkgs.follows = "nixpkgs";
  };

  flake.githubActions = inputs.nix-github-actions.lib.mkGithubMatrix {
    checks = lib.mapAttrs (_: lib.flip removeAttrs [ "check-flake-file" ]) (
      lib.getAttrs [ "x86_64-linux" ] self.checks
    );
  };
}
